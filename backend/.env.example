# Copier ce fichier en ".env" et remplir les valeurs. Ne JAMAIS commiter ".env".

# --- Django ---
DJANGO_SECRET_KEY=change-me-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# En production, remplace localhost par le domaine API et active les options TLS ci-dessous.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_BEHIND_HTTPS_PROXY=true  # seulement si le proxy définit X-Forwarded-Proto

# --- Front (CORS) : origines autorisées à appeler l'API, séparées par des virgules ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Base de données ---
# Supabase : coller l'URI PostgreSQL depuis Connect > URI (pooler de session conseillé).
# DATABASE_URL active PostgreSQL même si USE_POSTGRES reste à false.
DATABASE_URL=
# Alternative sans URI : USE_POSTGRES=true et renseigner les champs ci-dessous.
USE_POSTGRES=false
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# --- Envoi des e-mails : choisir Resend OU SMTP (jamais les deux) ---
# Option A — Resend : nécessite un domaine vérifié (l'URL Vercel ne peut pas l'être).
# RESEND_API_KEY=re_...
# DEFAULT_FROM_EMAIL=MediCare Connect <noreply@votre-domaine.example>

# Option B — SMTP gratuit (Gmail ou Brevo) : aucun domaine à vérifier.
# Renseigner les variables ci-dessous (elles priment sur RESEND_API_KEY s'il reste définie) :
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=votre-adresse@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-d-application
DEFAULT_FROM_EMAIL=MediCare Connect <votre-adresse@gmail.com>

# --- Réinitialisation du mot de passe : URL de la page du FRONT qui reçoit ?uid=...&token=... ---
PASSWORD_RESET_URL=https://medicare-app-flax.vercel.app/reset-password
