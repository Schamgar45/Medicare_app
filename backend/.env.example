# Copier ce fichier en ".env" et remplir les valeurs. Ne JAMAIS commiter ".env".

# --- Django ---
DJANGO_SECRET_KEY=change-me-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Front (CORS) : origines autorisées à appeler l'API, séparées par des virgules ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Base de données ---
# USE_POSTGRES=false -> SQLite locale (db.sqlite3). true -> PostgreSQL ci-dessous.
USE_POSTGRES=false
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# --- Envoi des e-mails (laisser EMAIL_HOST vide pour le mode console local) ---
# Exemple Brevo : EMAIL_HOST=smtp-relay.brevo.com, EMAIL_PORT=587, EMAIL_USE_TLS=true
# EMAIL_HOST_USER = identifiant SMTP Brevo; EMAIL_HOST_PASSWORD = clé SMTP, pas clé API.
# DEFAULT_FROM_EMAIL doit être une adresse expéditrice vérifiée dans Brevo.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
# EMAIL_TIMEOUT=10

# --- Réinitialisation du mot de passe : URL de la page du FRONT qui reçoit ?uid=...&token=... ---
PASSWORD_RESET_URL=http://localhost:5173/reset-password
