{
    // Interpreteur Python du backend : le venv vit dans backend/.venv
    "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
    "python.terminal.activateEnvironment": true,

    // Ne pas analyser les fichiers Python hors backend (le venv racine a ete supprime)
    "python.analysis.extraPaths": ["${workspaceFolder}/backend"],

    // terminal par defaut dans le terminal integre
    "python.defaultInterpreterPath.manual": true,

    // Ajoute Node aux terminaux integres et expose npm.cmd dans PowerShell.
    "terminal.integrated.env.windows": {
        "PATH": "C:\\Program Files\\nodejs;${env:PATH}"
    },
    "terminal.integrated.profiles.windows": {
        "PowerShell (MediCare)": {
            "path": "${env:windir}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": [
                "-NoExit",
                "-Command",
                "$nodeDir = Join-Path $env:ProgramFiles 'nodejs'; $env:Path = \"$nodeDir;$env:Path\"; Set-Alias -Name npm -Value (Join-Path $nodeDir 'npm.cmd')"
            ],
            "icon": "terminal-powershell"
        }
    },
    "terminal.integrated.defaultProfile.windows": "PowerShell (MediCare)",

    // ESLint / Prettier cote front
    "editor.formatOnSave": false,
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "eslint.workingDirectories": ["${workspaceFolder}/frontend"],
    "eslint.validate": ["typescript", "typescriptreact"],

    // Fichiers exclus de l'explorateur
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/dist": true,
        "**/.venv": true,
        "**/db.sqlite3": true
    }
}